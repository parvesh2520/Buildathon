# Copy to .env (git-ignored) and fill in. NAMES ONLY here - never commit real values.
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
DRONAHQ_API_KEY=
DRONAHQ_BASE_URL=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Guardrail configuration (read by guardrails.py)
SDR_CANARY_TOKEN=            # generate once: python -c "import guardrails; print(guardrails.new_canary())"
SDR_POSTAL_ADDRESS=          # physical postal address printed in every commercial email (CAN-SPAM)
SDR_MAX_COST_PER_LEAD=0.05
SDR_MAX_TOTAL_USD=25
