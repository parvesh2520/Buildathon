APP_NAME=Autonomous SDR API
APP_ENV=development

# Gmail / SMTP Settings
# Get an App Password from Google: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SENDER_EMAIL=your_gmail@gmail.com

# DronaHQ Automation Webhook Credentials
DRONAHQ_WEBHOOK_URL=https://automations.dronahq.com/webhooks/your-webhook-id
DRONAHQ_API_KEY=your_dronahq_api_key

# DronaHQ Follow-up Agent Credentials
DRONAHQ_FOLLOWUP_AGENT_URL=https://automations.dronahq.com/webhooks/your-followup-agent-webhook-id
DRONAHQ_FOLLOWUP_AGENT_ID=your_followup_agent_id
DRONAHQ_FOLLOWUP_AGENT_KEY=your_followup_webhook_key_if_required
FOLLOWUP_SCHEDULER_INTERVAL_SECONDS=0

# DronaHQ Email Outreach Executor Webhook Credentials
DRONAHQ_EMAIL_EXECUTOR_WEBHOOK_URL=https://automations.dronahq.com/webhooks/your-email-executor-webhook-id
DRONAHQ_EMAIL_EXECUTOR_API_KEY=your_dronahq_email_executor_api_key

# DronaHQ SMS Outreach Executor Webhook Credentials
DRONAHQ_SMS_EXECUTOR_WEBHOOK_URL=https://automations.dronahq.com/webhooks/your-sms-executor-webhook-id
DRONAHQ_SMS_EXECUTOR_API_KEY=your_dronahq_sms_executor_api_key

# Twilio SMS Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# DronaHQ Voice Outbound Agent Credentials
DRONAHQ_VOICE_AGENT_ENDPOINT=https://agents-backend.dronahq.com/voice/outbound/dispatch
DRONAHQ_VOICE_AGENT_ID=b7f2d792-925e-429a-8551-0cb0207c72d9
DRONAHQ_SOURCE_PHONE=+1234567890

